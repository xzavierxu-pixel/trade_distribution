[Unit]
Description=Fortune Bot BTC 5m paper run
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/fortune_bot
EnvironmentFile=-%h/fortune_bot/execution_engine/secrets.env
ExecStart=%h/fortune_bot/.venv/bin/python -m execution_engine.run_once --config %h/fortune_bot/config.yaml --mode paper --print-json

